    {
      "parameters": {
        "jsCode": "// Find which stored row(s) the admin means by \"/verify <name>\".\nconst input = $('When Executed by Another Workflow').first().json;\nconst arg = String(input.argument || '').trim();\n\n// Same identity rule as Validate + dedupe (Fix #7): \"Pipe Drive\", \"Pipedrive CRM\" -> \"pipedrive\"\nconst clean = v => String(v ?? '').replace(/\\s+/g, ' ').trim();\nconst normName = n => clean(n).toLowerCase()\n  .replace(/[®™©]/g, '')\n  .replace(/\\.(com|io|ai|co|app)\\b/g, ' ')\n  .replace(/\\b(crm|software|app|inc|ltd|the|platform)\\b/g, ' ')\n  .replace(/[^a-z0-9]+/g, ' ')\n  .trim()\n  .replace(/ by [a-z0-9]+$/, '')\n  .trim();\nconst keyOf = n => normName(n).replace(/ /g, '');\n\nif (!arg) {\n  return [{ json: { found: false, text: 'Usage: /verify <tool name>, e.g. /verify HubSpot' } }];\n}\n\nconst q = keyOf(arg);\nconst rows = $input.all().map(i => i.json).filter(r => r.tool_key);\n\n// 1. Exact identity match (may hit the same tool in two categories: both are verified)\nlet hits = rows.filter(r => String(r.tool_key).split('|')[1] === q);\n\n// 2. Otherwise a prefix match (\"/verify zoho\" -> \"Zoho CRM\"), but only if it is unique\nif (hits.length === 0) {\n  const pref = rows.filter(r => keyOf(r.name).startsWith(q));\n  if (pref.length === 1) hits = pref;\n  else if (pref.length > 1) {\n    return [{ json: { found: false,\n      text: `\"${arg}\" matches several tools: ${pref.map(r => r.name).join(', ')}. Send the full name.` } }];\n  }\n}\n\nif (hits.length === 0) {\n  return [{ json: { found: false,\n    text: `No stored tool named \"${arg}\". Send /pending to see what can be verified.` } }];\n}\n\nconst today = new Date().toISOString().slice(0, 10);\nreturn hits.map(r => ({ json: {\n  found: true,\n  tool_key: r.tool_key,\n  name: r.name,\n  status: 'verified',\n  verified_by: 'admin via Telegram',\n  last_checked: today,\n  notes: (`verified on ${today}` + (r.notes ? ` | ${r.notes}` : '')).slice(0, 500)\n}}));"
      },
