    {
      "parameters": {
        "jsCode": "// Build one Telegram message listing rows that still need a human check.\nlet rows = $input.all().map(i => i.json).filter(r => r.tool_key && r.status !== 'verified');\nif (rows.length === 0) return [{ json: { text: 'Nothing to check: every stored tool is verified.' } }];\n\n// Rows whose price changed after a verification come first: they matter most.\nconst changed = r => /changed on|refresh on/.test(String(r.notes || ''));\nrows.sort((a, b) => Number(changed(b)) - Number(changed(a)));\n\nconst hasPrice = r => r.price_per_user_month !== '' && r.price_per_user_month != null;\nconst fmt = r => `• ${r.name} (${r.category}): ` +\n  (hasPrice(r) ? `${r.price_per_user_month} ${r.currency}/user/month` : 'price unknown') +\n  `\\n  ${r.source_url}` + (r.notes ? `\\n  note: ${String(r.notes).slice(0, 250)}` : '');\n\nconst head = `${rows.length} tool(s) waiting for a check:\\n\\n`;\nconst tail = '\\n\\nOpen each link and compare. If it is right, send /verify <name>. ' +\n             'If not, correct the row in the Tools sheet and set its status to verified.';\n\n// Telegram refuses messages over 4,096 characters: add entries until the next one would not fit.\nconst LIMIT = 4000;\nlet body = '', shown = 0;\nfor (const r of rows) {\n  const line = (shown ? '\\n' : '') + fmt(r);\n  if (head.length + body.length + line.length + tail.length + 60 > LIMIT) break;\n  body += line; shown++;\n}\nconst more = shown < rows.length ? `\\n…and ${rows.length - shown} more in the Tools sheet.` : '';\nreturn [{ json: { text: head + body + more + tail } }];"
      },
      "type": "n8n-nodes-base.code",
