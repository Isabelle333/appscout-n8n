    {
      "parameters": {
        "jsCode": "// One row per ranked tool, best first. Read from Filter + rank, not from the Telegram reply.\nconst all = $('Filter + rank').first().json.all;\nif (all.length === 0) return [{ json: { rank: '', name: 'No tool matched your criteria' } }];\nreturn all.map((t, i) => ({ json: {\n  rank: i + 1, name: t.name, plan: t.plan_name,\n  price_per_user_month: t.price_per_user_month, currency: t.currency, price_eur: t.price_eur,\n  price_note: t.price_note, free_plan: t.free_plan, matched_must_haves: t.matched, score: t.score,\n  status: t.status, key_features: t.key_features, integrations: t.integrations,\n  best_for: t.best_for, source_url: t.source_url, last_checked: t.last_checked\n}}));"
      },
