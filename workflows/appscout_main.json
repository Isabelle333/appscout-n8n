    {
      "parameters": {
        "jsCode": "const c = $('Parse request').first().json.output;          // the criteria\nconst USD_TO_EUR = 0.89;   // approximate: check today's rate before the demo and update\nconst GBP_TO_EUR = 1.19;\n\nconst isTrue = v => v === true || String(v).toUpperCase() === 'TRUE';\nconst rows = $input.all().map(i => i.json).filter(r => r.tool_key);\nconst must = (c.must_haves || []).map(m => String(m).toLowerCase());\nconst budget = Number(c.budget_per_user_eur) > 0 ? Number(c.budget_per_user_eur) : null;\nconst freeRequired = isTrue(c.free_plan_required);           // fix: the text \"false\" is not true\n\nconst priceEur = r => {\n  const p = parseFloat(String(r.price_per_user_month).replace(',', '.'));\n  if (!Number.isFinite(p)) return null;                      // unknown price stays unknown\n  if (r.currency === 'USD') return p * USD_TO_EUR;\n  if (r.currency === 'GBP') return p * GBP_TO_EUR;\n  return p;\n};\n\nconst scored = [];\nfor (const r of rows) {\n  const p = priceEur(r);\n  const free = isTrue(r.free_plan);\n  if (budget !== null && p !== null && p > budget) continue;  // over budget: removed\n  if (freeRequired && !free) continue;                        // free plan required\n\n  const text = `${r.key_features} ${r.integrations} ${r.best_for}`.toLowerCase();\n  const matched = must.filter(m => m.split(/\\s+/).every(w => text.includes(w)));\n\n  let score = must.length ? 3 * matched.length / must.length : 0;\n  if (free) score += 1;\n  if (r.status === 'verified') score += 1;\n  if (budget !== null && p !== null) score += 1 - p / budget;\n\n  scored.push({ ...r,\n    price_eur: p === null ? '' : Math.round(p * 100) / 100,\n    matched: matched.join(', '),\n    score: Math.round(score * 100) / 100 });\n}\n\n// Highest score first. On a tie, the cheaper tool first; unknown prices last (fix: ties were in sheet order).\nconst priceKey = t => (t.price_eur === '' ? Number.MAX_VALUE : t.price_eur);\nscored.sort((a, b) => (b.score - a.score) || (priceKey(a) - priceKey(b)));\n\nconst stale = rows.some(r => r.stale);\nreturn [{ json: {\n  criteria: c,\n  top: scored.slice(0, 5),\n  all: scored,\n  considered: rows.length,\n  cache_hit: rows.length > 0 && rows.every(r => r.from_cache) && !stale,   // Fix #2\n  stale\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
