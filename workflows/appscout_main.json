        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "={{ String($json.output?.category || '').trim().toLowerCase() === 'unsupported'\n  ? 'I can only compare CRM, project management and email marketing tools for now. Try: /compare email marketing tool for a 5-person shop under 15 euros'\n  : 'Tell me what you need after /compare, for example: /compare CRM for 10 people under 20 euros per user, needs lead scoring' }}",
